{
  "name": "pi-stuff",
  "version": "0.1.0",
  "private": true,
  "description": "amikai's pi coding agent extensions",
  "readme": "README.md",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "./extensions/*.ts",
      "./extensions/*/index.ts"
    ],
    "themes": [
      "./themes/*.json"
    ]
  },
  "scripts": {
    "test": "node --test test/you-should-know.test.ts test/prismantis.test.ts",
    "sync:prismantis": "node scripts/sync-prismantis.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*"
  }
}

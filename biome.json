{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!extensions/prism/core/vendor", "!package-lock.json"] },
  "formatter": { "indentStyle": "space", "lineWidth": 120, "indentWidth": 2 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": { "noUselessTypeConstraint": "error" },
      "performance": { "noReExportAll": "error" },
      "style": {
        "useAsConstAssertion": "error",
        "useConsistentArrayType": "error",
        "useConst": "error",
        "useShorthandFunctionType": "error",
        "useSingleVarDeclarator": "error"
      },
      "suspicious": { "noExtraNonNullAssertion": "error" }
    }
  },
  "overrides": [
    {
      "includes": [
        ".pi/skills/verify/scripts/control-prism.mjs",
        "extensions/pi-built-in-render/render.ts",
        "extensions/prism/core/figure.ts",
        "extensions/prism/core/markdown.ts",
        "extensions/prism/core/mermaid.ts",
        "extensions/prism/core/render.ts",
        "extensions/prism/pane-viewer.mjs",
        "extensions/prism/renderer.ts",
        "test/prism.test.ts"
      ],
      "linter": { "rules": { "suspicious": { "noControlCharactersInRegex": "off" } } }
    }
  ],
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
  "markdown": { "formatter": { "enabled": false } }
}
